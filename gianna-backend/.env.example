# Coolify production settings. API key is a RUNTIME secret, not a build argument.
FLASK_ENV=production
HOST=0.0.0.0
PORT=5000
# Exact HTTPS frontend origin(s), comma-separated, without paths/trailing slash.
CORS_ORIGINS=https://turismo.example
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
# Applies to router, answers, web research and fallback.
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
# Local Windows: FLASK_ENV=development, HOST=127.0.0.1,
# OLLAMA_HOST=http://127.0.0.1:11434, no API key, and your localhost CORS origin.
# OLLAMA_BASE_URL remains supported if OLLAMA_HOST is not set.

# Fixed retrieval pair; other IDs are rejected at startup.
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
QDRANT_COLLECTION=giana_granite_cpu_v1
# Embedded Qdrant persists in storage/qdrant.
CPU_THREADS=4
MODEL_BATCH_SIZE=8
MODEL_MAX_TOKENS=512
WEB_CONSENT_TTL_SECONDS=120
GIANA_DIAGNOSTICS=false
