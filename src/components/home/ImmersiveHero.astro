---
import JourneyHero from '../../islands/JourneyHero';
---
<section class="journey-hero" id="inicio" aria-labelledby="journey-title">
  <JourneyHero client:load />
  <div class="journey-edge-controls">
    <a class="journey-scroll" href="#experiencias">SEGUÍ DESCUBRIENDO <span aria-hidden="true">↓</span></a>
    <div>
      <button id="hero-replay" aria-label="Volver a empezar el recorrido" title="Volver a empezar">↺</button>
      <button class="motion-toggle" id="motion-toggle" aria-label="Pausar movimiento" aria-pressed="false" title="Pausar o continuar el recorrido"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg></button>
    </div>
  </div>
</section>
