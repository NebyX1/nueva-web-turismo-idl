# Frontend: separate Coolify resource. Set this as a BUILD variable.
# Empty = same-origin /api proxy (Compose); otherwise the HTTPS backend origin.
# No trailing /api. Example: https://gianna-api.turismo.example
PUBLIC_GIANNA_API_BASE=

# Server-side dev/preview or nginx proxy target, only needed in proxy mode.
GIANNA_BACKEND_URL=http://127.0.0.1:5000

# Compose only: runtime secrets/configuration for the backend, never PUBLIC_.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
# Exact frontend origins, comma-separated. Required for separate resources.
CORS_ORIGINS=
